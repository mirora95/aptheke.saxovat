# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Base URL of the deployed backend API. No trailing slash.
# In development this defaults to http://localhost:5062 when left blank.
VITE_API_BASE_URL=https://api.yourdomain.com

# Optional: Google Gemini API key for AI features.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# ─── Backend / Docker Compose ─────────────────────────────────────────────────
POSTGRES_DB=saxovat_pharmacy
POSTGRES_USER=saxovat
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>

# The API container reads this directly. Replace with your prod host when not using Docker Compose.
ConnectionStrings__PostgreSql=Host=db;Database=saxovat_pharmacy;Username=saxovat;Password=<YOUR_POSTGRES_PASSWORD>

# OneC integration base URL (leave as-is if not using OneC sync).
OneC__BaseUrl=http://localhost/InfoBase/hs/productapi/

# JWT signing key — must be at least 32 characters. Change before deploying.
Jwt__Key=<REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS>
Jwt__Issuer=SaxovatAPI
Jwt__Audience=SaxovatClient
