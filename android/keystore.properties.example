# Copy this file to keystore.properties and fill in real values.
# NEVER commit keystore.properties or the .jks file to version control.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore saxovat-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias saxovat
#
storeFile=../../saxovat-release.jks
storePassword=saxovat
keyAlias=saxovat
keyPassword=saxovat
